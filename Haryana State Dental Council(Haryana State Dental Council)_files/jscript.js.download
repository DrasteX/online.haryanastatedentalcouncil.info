                function upload_file(e){                   
                var form_data = new FormData();              
                form_data.append('_file', document.getElementById(e).files[0]);
                form_data.append('form_data',$('#form_data_'+e).val);
                $.ajax({
                                    cache: false,
                                    type: "POST",
                                    url:base_url+'UploadDocumetns',
                                    data: form_data,
                                    dataType: "text",
                                    contentType: false,
                                    processData: false,
                                    success:function(data){
                                    const resp = JSON.parse(data);
                                    var result=window.atob(resp.result);
                                    if(resp.status===true){
                                        $('#'+e).attr('type', 'text');
                                    }else{
                                        //$('#upload_response').html(result);
                                        alert(result);
                                    }
                                    }
                                }); 
                }
                
                function mysql_date(d){
                    //This function should be used to change date format from dd/mm/yyyy to yyyy-mm-dd//
                    var db_date=d.split('/');
                    var db_date=(db_date[2]+'-'+db_date[1]+'-'+db_date[0]);
                    return db_date;
                }
                 function show_modal(type)
                {
                    if (type == "Add_Rec") {
                        $('#Add').modal('show');
                    }
                    if (type == "Updt_Rec") {
                        $('#Updt').modal('show');
                    }
                    if (type == "Del_Rec") {
                    $('#Del').modal('show');
                    }
                };
function printArea(areaID) {
    var printContent = document.getElementById(areaID).cloneNode(true);
    var WinPrint = window.open('', '', 'width=900,height=650');
    WinPrint.document.write(`<html><head>
                <title>Print Application</title>
                <style>
                    @media print {
                        @page {
                            size: auto;
                            margin: 15;
                        }
                        body {
                            margin: 15;
                            padding: 0;
                        }
                        img {
                            display: block !important;
                            visibility: visible !important;
                        }
                    }
                    body {
                        font-family: Arial, sans-serif;
                        font-size: 12px;
                        margin: 15;
                        padding: 0;
                    }
                </style>
            </head>
            <body></body>
        </html>
    `);
    WinPrint.document.body.appendChild(printContent);
    WinPrint.document.close();
    var images = WinPrint.document.images;
    var imagesLoaded = 0;
    function checkImagesLoaded() {
        imagesLoaded++;
        if (imagesLoaded === images.length) {
            triggerPrint(); // Trigger the print dialog once all images are loaded
        }
    }

    // Attach the load event to all images
    for (var i = 0; i < images.length; i++) {
        if (images[i].complete) {
            checkImagesLoaded(); // If the image is already loaded
        } else {
            images[i].addEventListener('load', checkImagesLoaded);
        }
    }

    // If no images exist, print immediately
    if (images.length === 0) {
        triggerPrint();
    }

    // Function to trigger the print dialog and close the window after printing
    function triggerPrint() {
        WinPrint.focus();     // Bring the new window into focus
        WinPrint.print();     // Trigger the print dialog
        WinPrint.onafterprint = function () {
            WinPrint.close(); // Close the window after printing is done
        };
    }
}
                var today = new Date();
                var dd = today.getDate();
                var mm = today.getMonth()+1; //January is 0!
                var yyyy = today.getFullYear();
                if(dd<10){ 
                    dd='0'+ dd;
                } 
                if(mm<10){
                    mm='0'+mm;
                } 
                var today = dd+'/'+mm+'/'+yyyy;
