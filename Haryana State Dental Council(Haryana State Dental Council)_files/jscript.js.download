            document.addEventListener("DOMContentLoaded", function () {

    // Handle #datetimepicker id
    const singlePicker = document.getElementById('datetimepicker');
    if (singlePicker) {
        new tempusDominus.TempusDominus(singlePicker, {
            localization: {
                format: 'yyyy-MM-dd HH:mm:ss'
            }
        });
    }

    // Handle all input[type="date"]
    document.querySelectorAll('input[type="date"]').forEach(function (input) {

        new tempusDominus.TempusDominus(input, {
            localization: {
                format: 'yyyy-MM-dd'
            },
            display: {
                components: {
                    clock: false
                }
            }
        });

    });

    // Handle all input[type="datetime"]
    document.querySelectorAll('input[type="datetime"]').forEach(function (input) {

        new tempusDominus.TempusDominus(input, {
            localization: {
                format: 'yyyy-MM-dd HH:mm:ss'
            },
            display: {
                components: {
                    seconds: true
                }
            }
        });

    });

});
                 $('#login_password').on('blur', (function () {

                    $('#user_name, #user_father_name, #user_email, #user_mobile, #user_dob, #user_password').change(function() {
                        const field = $(this).attr('name');
                        const value = $(this).val();
                
                        $.ajax({
                            url: base_url+'validate_user_data',
                            type: 'POST',
                            data: { field: field, value: value, [csrf_token] : csrf_hash },
                            success: function(response) {
                              // alert(response);
                                const result = JSON.parse(response);
                
                                if (result.status === 'error') {
                                    showError(field, result.message);
                
                                    // Show SweetAlert for validation error
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Validation Error',
                                        text: result.message,
                                    });
                                } else {
                                    clearError(field);
                                }
                            }
                        });
                    });

                var v_json = {x:window.btoa(unescape(encodeURIComponent($('#login_password').val()))),[csrf_token] : csrf_hash};   
                        $.ajax({
                                    cache: false,
                                    type: "POST",
                                    url:base_url+'encr_pwd',
                                    data: v_json,
                                    dataType: "HTML",
                                    success:function(data){
                                    $('#login_password').val(data);
                                    }
                                });            

                        }));
                        $('#user_name, #user_father_name, #user_email, #user_mobile, #user_dob, #user_password').change(function() {
                            const field = $(this).attr('name');
                            const value = $(this).val();
                    		
                            $.ajax({
                                url: base_url+'validate_user_data',
                                type: 'POST',
                                data: { field: field, value: value, [csrf_token] : csrf_hash },
                                success: function(response) {
                                  // alert(response);
                                    const result = JSON.parse(response);
                    
                                    if (result.status === 'error') {
                                        showError(field, result.message);
                    
                                    } else {
                                        clearError(field);
                                    }
                                }
                            });
                        });
                        $('#confirm_user_password').blur(function() {
                            const password = $('#user_password').val();
                            const confirmPassword = $(this).val();
                    
                            if (password !== confirmPassword) {
                                showError('confirm_user_password', 'Passwords do not match.');
                    
                                // Show SweetAlert for password mismatch
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Password Mismatch',
                                    text: 'Passwords do not match.',
                                });
                            } else {
                                clearError('confirm_user_password');
                            }
                        });
                });
                function showError(field, message) {
                    const safeField = CSS.escape(field);
                    const errorDivId = `${safeField}ErrorDiv`;
                    let errorDiv = $(`#${errorDivId}`);
                    if (errorDiv.length === 0) {
                        // Create error div if it doesn't exist
                        // errorDiv = $(`<div id="${errorDivId}" class="invalid-feedback" style="color:red;font-size:0.9em;margin-top:5px;">${message}</div>`);
                        errorDiv = $(`<div id="${errorDivId}" class="is-invalid" style="color:red;font-size:0.9em;margin-top:5px;"></div>`).text(message);
                        $(`[name="${safeField}"]`).after(errorDiv);
                    } else {
                        // Update the error message if div already exists
                        errorDiv.text(message);
                    }
                    // Add invalid class to the field and clear its value
                    //$(`[name="${field}"]`).addClass('is-invalid').val('');
                }
                function clearError(field) {
                    const errorDivId = `${field}ErrorDiv`;
                    $(`#${errorDivId}`).remove();
                    $(`[name="${field}"]`).removeClass('is-invalid');
                }
                      function Sleep(time) {
                          return new Promise((resolve) => setTimeout(resolve, time));
                      }
